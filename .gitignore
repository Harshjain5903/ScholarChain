# macOS
.DS_Store

# IDE
.idea/
.vscode/
.bsp/
metals.sbt
.metals/
.bloop/

# sbt
target/
project/target/
project/project/

# Scala
*.class
*.tasty

# Environment / secrets — never commit
.env
.env.*
*.pem
*.key
credentials.json

# Claude local settings (not constitutional)
.claude/settings.local.json

# Test marker (generated build output)
.claude/.last-test-run

# Terraform state (managed by infra-engineer)
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl is intentionally tracked to pin provider versions/hashes (human architect decision).

# Logs
*.log

# Docker compose overrides (local only)
docker-compose.override.yml

# Packaging artifacts
*.jar
!lib/*.jar

# Node (if any tooling)
node_modules/

# Datasets and local pipeline outputs — never commit
# Raw source snapshots (e.g. DBLP dblp.xml.gz / dblp.dtd under
# datasets/raw/dblp/<snapshot>/, Crossref/OpenAlex/ORCID API envelopes
# under datasets/raw/<source>/). Manifests, scripts, schema notes and
# license records elsewhere under datasets/ remain tracked.
datasets/raw/
datasets/cache/
datasets/derived/
# Local Hadoop/Spark run output roots
local-runs/
# Terraform plan files (may embed sensitive values)
*.tfplan
# Note: .DS_Store is already ignored at every depth by the macOS rule above.
