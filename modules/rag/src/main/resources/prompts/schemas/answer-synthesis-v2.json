{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "answer-synthesis-v2",
  "title": "AnswerSynthesisAgent output",
  "type": "object",
  "required": ["claims"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["claimId", "statement", "confidence", "evidenceIds"],
        "additionalProperties": false,
        "properties": {
          "claimId": {"type": "string", "minLength": 1, "maxLength": 64},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "uncertainty": {"type": "string", "maxLength": 500}
        }
      }
    },
    "abstain": {"type": "boolean"},
    "abstainReason": {"type": "string", "maxLength": 500}
  }
}
